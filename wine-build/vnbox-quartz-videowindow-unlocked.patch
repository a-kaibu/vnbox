     return CONTAINING_RECORD(iface, struct filter_graph, IVideoWindow_iface);
 }
 
+/* vnbox: the video renderer's IVideoWindow methods move, show and hide its window, which
+ * may send messages to the application's UI thread. Holding the graph lock across those
+ * calls deadlocks when that UI thread forwards a message through NotifyOwnerMessage (or
+ * calls any other IVideoWindow method) at the same time, so the renderer is only looked up
+ * under the lock and called without it. */
 static HRESULT WINAPI VideoWindow_QueryInterface(IVideoWindow *iface, REFIID iid, void **out)
 {
     struct filter_graph *graph = impl_from_IVideoWindow(iface);
@@ -3958,10 +3963,16 @@ static HRESULT WINAPI VideoWindow_put_Caption(IVideoWindow *iface, BSTR strCapti
         hr = GetTargetInterface(This, &IID_IVideoWindow, (LPVOID*)&pVideoWindow);
 
     if (hr == S_OK)
-        hr = IVideoWindow_put_Caption(pVideoWindow, strCaption);
+        IVideoWindow_AddRef(pVideoWindow);
 
     LeaveCriticalSection(&This->cs);
 
+    if (hr == S_OK)
+    {
+        hr = IVideoWindow_put_Caption(pVideoWindow, strCaption);
+        IVideoWindow_Release(pVideoWindow);
+    }
+
     return hr;
 }
 
