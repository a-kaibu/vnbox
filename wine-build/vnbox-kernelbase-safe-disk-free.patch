+/* vnbox: old installers multiply the free space out in 32 bits (or truncate the 64-bit value),
+ * so with e.g. 4.2 GB free they see 0.2 GB and refuse to install. Report at most the real free
+ * space, lowered so that its low 32 bits are just under 2 GB: 32-bit arithmetic (signed or not)
+ * then always sees about 2 GB, and 64-bit callers lose less than 4 GB. */
+static ULONGLONG vnbox_safe_free( ULONGLONG real )
+{
+    const ULONGLONG low = 0x80000000ull - 0x100000ull;  /* 2 GB - 1 MB */
+    if (real < low) return real;
+    return ((real - low) & ~0xffffffffull) + low;
+}
+
