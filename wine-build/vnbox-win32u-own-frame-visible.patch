--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -2014,6 +2014,13 @@
     if (visible_rect.top >= visible_rect.bottom) visible_rect.bottom = visible_rect.top + 1;
     if (visible_rect.left >= visible_rect.right) visible_rect.right = visible_rect.left + 1;
 
+    /* vnbox: a window that draws its own frame (WM_NCCALCSIZE gives the client area the caption
+     * space, e.g. Chromium / NW.js / Electron) would lose the top of its client area to the
+     * decorations we assume the window manager draws. Show the whole window instead. */
+    if (rects->client.top < visible_rect.top || rects->client.left < visible_rect.left ||
+        rects->client.right > visible_rect.right || rects->client.bottom > visible_rect.bottom)
+        return rects->window;
+
     TRACE( "hwnd %p, rects %s, style %#x, ex_style %#x -> visible_rect %s\n", hwnd,
            debugstr_window_rects( rects ), style, ex_style, wine_dbgstr_rect( &visible_rect ) );
     return visible_rect;
