+/* vnbox: mouse-in-pointer mode, as in upstream Wine 11.3+ (MR 10120). Unity 6's input system
+ * calls EnableMouseInPointer and then expects WM_POINTER messages for the mouse. The mouse
+ * messages are still delivered as usual; each one is preceded by the matching WM_POINTER*
+ * message sent to the same window, and GetPointerInfo reports that pointer frame. */
+static LONG mouse_in_pointer = -1;
+static pthread_mutex_t mouse_pointer_mutex = PTHREAD_MUTEX_INITIALIZER;
+static POINTER_INFO mouse_pointer;
+
 BOOL WINAPI NtUserEnableMouseInPointer( BOOL enable )
 {
-    FIXME( "enable %u stub!\n", enable );
-    RtlSetLastWin32Error( ERROR_CALL_NOT_IMPLEMENTED );
-    return FALSE;
+    TRACE( "enable %u\n", enable );
+    if (InterlockedCompareExchange( &mouse_in_pointer, enable ? 1 : 0, -1 ) != -1)
+    {
+        RtlSetLastWin32Error( ERROR_ACCESS_DENIED );
+        return FALSE;
+    }
+    return TRUE;
+}
+
+/* called for a client-area mouse message about to be returned to the application */
+void send_mouse_pointer_message( const MSG *msg )
+{
+    static UINT32 frame;
+    UINT keys = LOWORD( msg->wParam ), message;
+    POINTER_FLAGS flags = POINTER_FLAG_PRIMARY;
+    POINTER_BUTTON_CHANGE_TYPE change = POINTER_CHANGE_NONE;
+    LARGE_INTEGER counter, freq;
+    INT32 data = 0;
+
+    if (mouse_in_pointer != 1) return;
+    switch (msg->message)
+    {
+    case WM_MOUSEMOVE: message = WM_POINTERUPDATE; flags |= POINTER_FLAG_UPDATE; break;
+    case WM_LBUTTONDOWN: case WM_LBUTTONDBLCLK: message = WM_POINTERDOWN; change = POINTER_CHANGE_FIRSTBUTTON_DOWN; break;
+    case WM_RBUTTONDOWN: case WM_RBUTTONDBLCLK: message = WM_POINTERDOWN; change = POINTER_CHANGE_SECONDBUTTON_DOWN; break;
+    case WM_MBUTTONDOWN: case WM_MBUTTONDBLCLK: message = WM_POINTERDOWN; change = POINTER_CHANGE_THIRDBUTTON_DOWN; break;
+    case WM_XBUTTONDOWN: case WM_XBUTTONDBLCLK:
+        message = WM_POINTERDOWN;
+        change = HIWORD( msg->wParam ) == XBUTTON2 ? POINTER_CHANGE_FIFTHBUTTON_DOWN : POINTER_CHANGE_FOURTHBUTTON_DOWN;
+        break;
+    case WM_LBUTTONUP: message = WM_POINTERUP; change = POINTER_CHANGE_FIRSTBUTTON_UP; break;
+    case WM_RBUTTONUP: message = WM_POINTERUP; change = POINTER_CHANGE_SECONDBUTTON_UP; break;
+    case WM_MBUTTONUP: message = WM_POINTERUP; change = POINTER_CHANGE_THIRDBUTTON_UP; break;
+    case WM_XBUTTONUP:
+        message = WM_POINTERUP;
+        change = HIWORD( msg->wParam ) == XBUTTON2 ? POINTER_CHANGE_FIFTHBUTTON_UP : POINTER_CHANGE_FOURTHBUTTON_UP;
+        break;
+    case WM_MOUSEWHEEL: message = WM_POINTERWHEEL; flags |= POINTER_FLAG_WHEEL; data = (SHORT)HIWORD( msg->wParam ); break;
+    case WM_MOUSEHWHEEL: message = WM_POINTERHWHEEL; flags |= POINTER_FLAG_HWHEEL; data = (SHORT)HIWORD( msg->wParam ); break;
+    default: return;
+    }
+    if (message != WM_MOUSEWHEEL && message != WM_POINTERWHEEL && message != WM_POINTERHWHEEL)
+    {
+        if (keys & MK_LBUTTON) flags |= POINTER_FLAG_FIRSTBUTTON;
+        if (keys & MK_RBUTTON) flags |= POINTER_FLAG_SECONDBUTTON;
+        if (keys & MK_MBUTTON) flags |= POINTER_FLAG_THIRDBUTTON;
+        if (keys & MK_XBUTTON1) flags |= POINTER_FLAG_FOURTHBUTTON;
+        if (keys & MK_XBUTTON2) flags |= POINTER_FLAG_FIFTHBUTTON;
+    }
+    flags |= POINTER_FLAG_INRANGE;
+    if (flags & (POINTER_FLAG_FIRSTBUTTON | POINTER_FLAG_SECONDBUTTON | POINTER_FLAG_THIRDBUTTON |
+                 POINTER_FLAG_FOURTHBUTTON | POINTER_FLAG_FIFTHBUTTON))
+        flags |= POINTER_FLAG_INCONTACT;
+    if (message == WM_POINTERDOWN) flags |= POINTER_FLAG_DOWN;
+    if (message == WM_POINTERUP) flags |= POINTER_FLAG_UP;
+    NtQueryPerformanceCounter( &counter, &freq );
+
+    pthread_mutex_lock( &mouse_pointer_mutex );
+    memset( &mouse_pointer, 0, sizeof(mouse_pointer) );
+    mouse_pointer.pointerType = PT_MOUSE;
+    mouse_pointer.pointerId = 1;
+    mouse_pointer.frameId = ++frame;
+    mouse_pointer.pointerFlags = flags;
+    mouse_pointer.sourceDevice = INVALID_HANDLE_VALUE;
+    mouse_pointer.hwndTarget = msg->hwnd;
+    mouse_pointer.ptPixelLocation = mouse_pointer.ptPixelLocationRaw = msg->pt;
+    mouse_pointer.ptHimetricLocation = mouse_pointer.ptHimetricLocationRaw = msg->pt;
+    mouse_pointer.dwTime = msg->time;
+    mouse_pointer.historyCount = 1;
+    mouse_pointer.InputData = data;
+    if (keys & MK_SHIFT) mouse_pointer.dwKeyStates |= POINTER_MOD_SHIFT;
+    if (keys & MK_CONTROL) mouse_pointer.dwKeyStates |= POINTER_MOD_CTRL;
+    mouse_pointer.PerformanceCount = counter.QuadPart;
+    mouse_pointer.ButtonChangeType = change;
+    pthread_mutex_unlock( &mouse_pointer_mutex );
+
+    TRACE( "%#x -> %#x flags %#x pt %d,%d\n", msg->message, message, flags, msg->pt.x, msg->pt.y );
+    /* pointer messages carry screen coordinates */
+    send_message( msg->hwnd, message, MAKEWPARAM( 1, (flags & (POINTER_FLAG_WHEEL | POINTER_FLAG_HWHEEL)) ? (WORD)data : LOWORD(flags) ),
+                  MAKELPARAM( msg->pt.x, msg->pt.y ) );
 }
 
