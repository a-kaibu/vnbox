<?xml version="1.0" encoding="UTF-8"?>
<!-- vnbox: ゲーム用 Xvfb の最小ウィンドウマネージャ設定。
     目的は Wine が頼む最大化・全画面 (_NET_WM_STATE) をちゃんと実行させることだけ。
     枠・タイトルバーは付けない (配信はゲームウィンドウの中身だけを取り込む)、デスクトップは 1 つ、キー・マウス割り当て無し -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <focus><focusNew>yes</focusNew><followMouse>no</followMouse></focus>
  <placement><policy>Smart</policy><center>yes</center></placement>
  <desktops><number>1</number></desktops>
  <margins><top>0</top><bottom>0</bottom><left>0</left><right>0</right></margins>
  <keyboard></keyboard>
  <mouse></mouse>
  <applications>
    <application class="*">
      <decor>no</decor>
    </application>
  </applications>
</openbox_config>
